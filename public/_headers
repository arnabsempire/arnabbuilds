# Static-host headers for Cloudflare (Workers static assets / Pages).
#
# Files in public/ are copied verbatim into the export, so this lands at
# out/_headers where Cloudflare reads it. The rules mirror netlify.toml exactly
# — if you change one, change the other.
#
# Cloudflare allows 100 rules on the free plan; three are in use.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Next fingerprints these filenames, so they can be cached permanently.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/arnab-aditya-das.jpg
  Cache-Control: public, max-age=604800, must-revalidate
